# Docker process UID/GID. Match the owner of your data directory.
ARCHIVER_UID=1000
ARCHIVER_GID=1000

# Optional HTTP CONNECT proxy, reachable FROM INSIDE the container.
# No username/password/subscription URL belongs here.
ARCHIVER_PROXY_URL=

# Optional X session. Leave empty for anonymous access.
# To enable, use exactly /data/private/x_cookies.txt
ARCHIVER_X_COOKIE_FILE=
